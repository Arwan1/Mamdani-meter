# Copy this file to .env. Never expose this key to the UI/browser.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest

# Everything below stays on this laptop by default.
NYCP_STORAGE_DIR=data
NYCP_DATABASE_PATH=data/nyc_civic.sqlite3
NYCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
NYCP_MIN_COVERAGE=0.6
NYCP_MAX_UPLOAD_BYTES=10485760
